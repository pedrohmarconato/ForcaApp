// ============================================================
// Frontend (Expo / React Native) — vai no bundle do app (público)
// NUNCA coloque chaves secretas com o prefixo EXPO_PUBLIC_
// ============================================================

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_DO_SUPABASE

# URL do backend Flask. Em dispositivo físico, use o IP da sua máquina
# na rede local (ex: http://192.168.0.10:5001/api)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api

# Modo offline do trainingPlanService: pula o backend e usa plano mock.
# Omitir ou "false" = desativado (fluxo normal). Usado em trainingPlanService.ts.
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=false

# Gate do card "Treinar junto" na Home + fluxo de convite/lobby (achado A1,
# review 2026-08-05). Depende da migration 0026 (supabase/migrations), ainda
# não aplicada em produção — sem ela o card quebra na criação. Decisão do
# dono: default OFF em produção, ON em dev/HML.
# "true"/"false" explícito sempre vence; omitido cai no __DEV__ do bundle
# (dev local = ON; build de release, HML incluído, = OFF até setar aqui).
# Ligar em HML: variável de ambiente Preview no painel do projeto Vercel
# (mesmo lugar de EXPO_PUBLIC_API_BASE_URL — ver docs/DEPLOY_WEB.md).
# Usado em src/config/featureFlags.ts.
EXPO_PUBLIC_ENABLE_JOINT_TRAINING=false

# ============================================================
# Backend (Flask) — NUNCA vai no app. Somente no servidor.
# ============================================================

# Chave da Anthropic usada SOMENTE pelo backend (proxy do Claude)
ANTHROPIC_API_KEY=sk-ant-SUA-CHAVE-AQUI

# Modelo Claude usado pelo backend (opcional; padrão claude-sonnet-4-6, ativo)
# NÃO usar claude-3-5-sonnet-20240620 — aposentado em 2025-10-28, requests falham.
CLAUDE_MODEL_NAME=claude-sonnet-4-6

# Modelo do chat (/api/chat, /api/consolidate-chat). Padrão: claude-haiku-4-5.
# Haiku 3 é mais barato porém deprecado/retira em 2026 — não usar.
CHAT_MODEL_NAME=claude-haiku-4-5

# Modelo da geração do molde (job async). Padrão: claude-opus-4-8.
# Usa adaptive thinking; NÃO usar fast mode.
PLAN_MODEL_NAME=claude-opus-4-8

# Feature flag da nova arquitetura molde+expansor+job.
# false (default): comportamento antigo (plano direto síncrono).
# true: novo fluxo (chat → diretrizes → molde Opus 4.8 → expansor → job polling).
FORCA_USE_MOLDE_ARCHITECTURE=false

# Layout do prompt do molde: system (persona + instruções + catálogo, estável)
# + user (questionário + diretrizes, volátil), com breakpoint de cache no fim
# do bloco estável. false (default) = o prompt de hoje, byte a byte.
# Ressalva: com poucas gerações por dia o cache de 5 min quase nunca é lido; a
# leitura garantida é a do retry dirigido, que reusa o mesmo prefixo.
FORCA_PROMPT_MOLDE_V2=false

# Schema do molde e das diretrizes via output_config.format (structured
# outputs) em vez de colado no texto do prompt. Ganhos: -18% de tokens de
# entrada por geração e forma do JSON garantida na origem.
# Custo, enquanto ligada: o modelo não emite `semanas_avulsas` (a válvula de
# escape não cabe nos limites de schema da API — deload continua indo por
# regra de progressão). NÃO substitui a validação local: a API não impõe
# minimum/maximum, então jsonschema + retry dirigido continuam ativos.
FORCA_STRUCTURED_OUTPUT=false

# Esforço do modelo na geração do molde: low|medium|high|xhigh|max.
# Vazio (default) = default da API (high) = comportamento atual. É a alavanca
# real de latência e custo; max_tokens é só um teto e não acelera nada.
# Mudar o esforço muda o plano gerado — trate como decisão de produto.
PLAN_EFFORT=

# Credenciais Supabase para o backend validar os tokens JWT dos usuários
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY_DO_SUPABASE

# Origens permitidas para CORS (separadas por vírgula). OBRIGATÓRIA no compose:
# sem ela o container se recusa a subir, de propósito. Deixar no valor de
# desenvolvimento em produção não quebra nada no servidor — quem bloqueia é o
# navegador, e o app mostra só "Network Error". Em produção/homologação, liste
# TODAS as origens do PWA daquele ambiente (a Vercel dá mais de um alias por
# deploy; `vercel inspect <url>` lista todos).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Ativa o modo debug do Flask (true/false). Sempre false em produção.
FLASK_DEBUG=false

# Porta do servidor Flask (opcional, padrão 5001)
PORT=5001

# Timeout (segundos) das chamadas à Anthropic no backend.
# Deve ser MENOR que o timeout do app (180s) para não cobrar geração perdida.
ANTHROPIC_TIMEOUT_SECONDS=150

# Rate limit por usuário (janela em segundos).
# ATENÇÃO: em memória — reinícios zeram e múltiplos workers multiplicam o
# limite efetivo. Para produção multi-worker, usar storage compartilhado.
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60
PLAN_RATE_LIMIT=3
PLAN_RATE_WINDOW_SECONDS=3600
